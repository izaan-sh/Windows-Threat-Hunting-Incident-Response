// Hunt 4 — Were any new accounts created?
// Lab investigation date: 7 October 2026 (UTC)
SecurityEvent
| where EventID == 4720
| where TimeGenerated between (datetime(2026-10-07T00:00:00Z) .. datetime(2026-10-07T23:59:00Z))
| project TimeGenerated, TargetUserName, SubjectUserName, SubjectDomainName
