// Hunt 8 — What happened before, during, and after suspicious activity?
// Master correlation view for the lab incident window (UTC).
union SecurityEvent, Event
| where TimeGenerated between (datetime(2026-10-07T09:18:00Z) .. datetime(2026-10-07T10:52:00Z))
| where EventID in (4624, 4625, 4634, 4720, 4732, 4698)
   or (Source == "Microsoft-Windows-Sysmon" and EventID in (1, 3, 11, 23))
   or (Source == "Microsoft-Windows-TaskScheduler" and EventID in (106, 200, 201))
| extend Detail = coalesce(Activity, RenderedDescription, strcat("EventID ", tostring(EventID)))
| project TimeGenerated, EventID, Source = iff(isempty(Source), "Security", Source), TargetUserName, IpAddress, Detail
| order by TimeGenerated asc
